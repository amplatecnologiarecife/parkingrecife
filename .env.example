# Servidor
PORT=3000

# Chave para assinar os tokens de login (troque por um valor longo e aleatorio)
JWT_SECRET=troque_esta_chave_por_uma_longa_e_aleatoria

# Regra de cobranca: valor por hora de permanencia
TARIFA_HORA=10

# Dados que aparecem no ticket impresso
EMPRESA_NOME=ESTACIONAMENTO RECIFE
EMPRESA_CNPJ=62.580.141/0001-88
EMPRESA_TELEFONE=81-9.8612-5798
EMPRESA_RODAPE=Obrigado e volte sempre!

# Endereco publico usado no QR Code do ticket (em producao: https://seudominio.com)
PUBLIC_URL=

# PostgreSQL (troque a password pela que definiu na instalacao)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=coloque_a_sua_password_aqui
DB_NAME=parking_recife

# Alternativa ao bloco DB_* acima: uma URL unica (usada por plataformas)
# Se preencher DATABASE_URL, ela tem prioridade sobre DB_HOST/DB_PORT/...
# DATABASE_URL=postgres://usuario:senha@host:5432/base
# DB_SSL=true

# Admin inicial: criado automaticamente na primeira vez, so se a base estiver vazia
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador
