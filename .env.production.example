# Ficheiro de exemplo para a VPS. Copie para .env e preencha.
PORT=3000

# Gere uma chave longa e aleatoria. Na VPS: openssl rand -hex 32
JWT_SECRET=coloque_uma_chave_longa_e_aleatoria

TARIFA_HORA=10

EMPRESA_NOME=ESTACIONAMENTO RECIFE
EMPRESA_CNPJ=62.580.141/0001-88
EMPRESA_TELEFONE=81-9.8612-5798
EMPRESA_RODAPE=Obrigado e volte sempre!

# Endereco publico (IP da VPS por agora; depois o dominio)
PUBLIC_URL=http://157.90.16.218

# PostgreSQL local da VPS
DB_HOST=localhost
DB_PORT=5432
DB_USER=parking
DB_PASSWORD=coloque_a_password_do_banco
DB_NAME=parking_recife

# Em plataformas (Render/Railway), use a URL unica em vez do bloco DB_* acima
# DATABASE_URL=postgres://usuario:senha@host:5432/base
# DB_SSL=true

# Admin inicial (criado uma vez, se a base estiver vazia)
ADMIN_EMAIL=admin@parking.com
ADMIN_PASSWORD=troque_esta_senha
ADMIN_NOME=Administrador
